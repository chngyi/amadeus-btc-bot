# Copy this file to .env and fill it in. Never commit .env.

# From @BotFather on Telegram
TELEGRAM_TOKEN=
# Your own chat ID: only this chat may use the bot
ALLOWED_CHAT_ID=

BOT_NAME=Amadeus
DISPLAY_TZ=Asia/Tokyo

# Optional: Claude rates the news and writes the explanations. Without it, keyword rules do.
ANTHROPIC_API_KEY=
# Optional: a healthchecks.io ping URL, so you hear about it when the bot is down
HEARTBEAT_URL=
